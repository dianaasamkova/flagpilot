# Copy to .env and fill in. Never commit .env.
# All values are server-side only: never prefix them with NEXT_PUBLIC_.

# Postgres on Neon (dev branch for local work). Added in M2.
DATABASE_URL=

# Model provider: fake | replay | gemini. Added in M3.
MODEL_PROVIDER=replay
# Google AI Studio key (free tier). Added in M3.
GEMINI_API_KEY=
# Gemini model ID, chosen at M3 after checking the free quota.
GEMINI_MODEL=
