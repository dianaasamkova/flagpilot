# Copy to .env (repo root) and fill in. Never commit .env.
# All values are server-side only: never prefix them with NEXT_PUBLIC_.

# Postgres. Empty: the app keeps data in memory and resets on restart.
# Local: any Postgres, e.g. postgresql://user@localhost:5432/flagpilot_dev
# Then run `pnpm db:migrate` once and, optionally, `pnpm db:seed`.
DATABASE_URL=

# Only for the Postgres store tests: a migrated, throwaway database. CI sets its own.
TEST_DATABASE_URL=

# Model provider: demo (offline, rule-based, no key) | gemini (M3).
MODEL_PROVIDER=demo
# Google AI Studio key (free tier). Added in M3.
GEMINI_API_KEY=
# Gemini model ID, chosen at M3 after checking the free quota.
GEMINI_MODEL=
