{
  "name": "@flagpilot/db",
  "private": true,
  "type": "module",
  "description": "FlagStore contract, in-memory and Postgres (Prisma) stores, seed data and write actions.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@flagpilot/domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  }
}
