{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "The flag key, e.g. \"checkout-new-button\"."
    },
    "env": {
      "description": "Only changes in this environment.",
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "production"
      ]
    },
    "limit": {
      "default": 10,
      "description": "How many changes to return, newest first. Default 10.",
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "required": [
    "key"
  ],
  "additionalProperties": false
}
