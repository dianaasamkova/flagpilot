{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "The flag key, e.g. \"checkout-new-button\"."
    }
  },
  "required": [
    "key"
  ],
  "additionalProperties": false
}
